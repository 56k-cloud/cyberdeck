#!/usr/bin/env python3
"""Generate inventory/hosts.ini from config.yml's `device` block.

Host, user, and SSH key live in ONE place (config.yml) so you don't hand-edit two
files and Ansible always connects with the right key. Re-run after editing
config.yml:

    scripts/gen-inventory

Stdlib only — no PyYAML — so it runs under any python3. The `device:` block is a
flat set of `key: value` scalars, which we parse directly (we don't need a full
YAML engine). config.yml is gitignored, so the generated hosts.ini is too.
"""
import pathlib
import re
import sys

root = pathlib.Path(__file__).resolve().parent.parent
cfg_path = root / "config.yml"
if not cfg_path.exists():
    sys.exit("config.yml not found — copy config.example.yml to config.yml first.")


def unquote(v: str) -> str:
    v = v.strip()
    if v[:1] in ("'", '"'):
        q = v[0]
        end = v.find(q, 1)
        return v[1:end] if end != -1 else v[1:]
    return v.split("#", 1)[0].strip()   # strip trailing inline comment


# Pull the flat scalars under the top-level `device:` block.
device = {}
in_block = False
for line in cfg_path.read_text().splitlines():
    if re.match(r"^device:\s*(#.*)?$", line):
        in_block = True
        continue
    if in_block:
        if re.match(r"^\S", line):      # next top-level key -> block ended
            break
        m = re.match(r"^\s+([A-Za-z0-9_]+):\s*(.*)$", line)
        if m:
            device[m.group(1)] = unquote(m.group(2))

name = device.get("name") or "deck"
host = device.get("host")
user = device.get("user")
key = device.get("ssh_private_key")

if not host or not user or host == "CHANGE_ME":
    sys.exit("config.yml needs device.host and device.user set (not CHANGE_ME).")

line = f"{name} ansible_host={host} ansible_user={user}"
if key:
    line += f" ansible_ssh_private_key_file={key}"

out = (
    "# Generated from config.yml by scripts/gen-inventory — do not edit by hand.\n"
    "[cyberdeck]\n"
    f"{line}\n\n"
    "[cyberdeck:vars]\n"
    "ansible_python_interpreter=/usr/bin/python3\n"
)

dest = root / "inventory" / "hosts.ini"
dest.write_text(out)
print(f"wrote {dest.relative_to(root)}:\n\n{out}")
